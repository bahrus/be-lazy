{
  "name": "be-lazy",
  "version": "0.0.33",
  "description": "Instantiate template when viewable.",
  "keywords": [
    "web-components",
    "web-component",
    "custom-element",
    "custom-elements"
  ],
  "main": "be-lazy.js",
  "module": "be-lazy.js",
